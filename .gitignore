# ── Secrets — never commit these ────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!*.env.example
*token.json*
*credentials.json*
*.pem
*.key
.credentials

# Your own company profile, if you keep it outside the tracked example
backend/company_profile.local.json

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ────────────────────────────────────────────────────────────
/build
frontend/build/
dist/
# The frontend build is copied into backend/static at deploy time.
backend/static/
.cache/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# ── Logs, editors, OS ───────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/
.DS_Store

# ── Data dumps and archives (never commit candidate data) ──────────────────
dump.rdb
*.zip
*.tar
*.tar.gz
*.tgz
*.bson
dumps/
exports/
backups/
