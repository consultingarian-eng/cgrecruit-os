# CGRecruit web app: build setting
#
# For LOCAL development, copy this file to frontend/.env.development.local
#   cp .env.example .env.development.local
# `npm start` reads that file; `npm run build` never does, so a live build can't
# accidentally point at your computer.
#
# Where the web app sends its API calls.
#   Local development (npm start): the backend on your computer.
#   Live build: EMPTY, so the app calls its own address (the deploy builds it
#   that way). Never build for production with a localhost value.
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional. The time zone used when an office has none set in
# Settings -> Region & Language. Match the backend's APP_TIMEZONE
# (UK: Europe/London). On Railway, add it as a service variable: the Docker
# build passes it in. [America/New_York]
# REACT_APP_TIMEZONE=

# Optional. A link to a presentation about your company, shown on the
# candidate status page (/applicant/...). Blank hides that section. On Railway,
# add it as a service variable before a deploy: the Docker build passes it in.
# REACT_APP_PRESENTATION_URL=
