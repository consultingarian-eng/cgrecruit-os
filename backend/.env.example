# CGRecruit backend settings
#
# Copy this file to backend/.env for a LOCAL run, and fill in only what you need.
# In production, put the same names in Railway -> Variables instead; never commit
# a real .env file. docs/SETUP.md ("Every setting") explains each one.
#
# Lines marked SECRET: set your own; there is no default and nobody else should
# ever see the value.
#
# Optional settings are commented out (# NAME=). Remove the # only when you give
# one a value: a setting present but empty can override a sensible default.
#
# Local safety: use a DB_NAME ending in _dev, and leave the Twilio, ElevenLabs and
# SendGrid lines blank so your computer can't text, call or email anyone.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# SECRET. Your MongoDB Atlas connection string (mongodb+srv://...), password included.
MONGO_URL=

# Database name. Locally something like recruit_dev; in production your live name.
DB_NAME=

# SECRET. Signs logins and the call-bridge stream links. At least 32 characters
# (the app refuses to start otherwise), e.g. the output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
JWT_SECRET=

# SECRET. Needed once, to create the first (owner) account with
# .claude/skills/setup/create_owner.py. Without it, the first account can't be
# made at all (so nobody can claim a fresh deployment before you). Remove it
# afterwards if you like; it does nothing once an owner exists.
SETUP_TOKEN=

# The home time zone for schedules, call windows, quiet hours, reminders and the
# times written into texts and emails. Each office's Settings -> Region & Language
# zone still wins where set. UK: Europe/London. [America/New_York]
APP_TIMEZONE=America/New_York

# How a phone number typed without a country code is read: US (10 digits get
# +1) or GB (07700 900123 becomes +447700900123). Numbers starting with + are
# always kept as typed. Set it before candidates arrive. [US]
PHONE_DEFAULT_COUNTRY=US

# The app's public address, no trailing slash. Used in candidates' links, Twilio
# and ElevenLabs callbacks, emails and the Claude connector.
# Locally: http://localhost:8000   Production: https://recruit.yourcompany.co.uk
APP_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Addresses (recommended; set them to match APP_PUBLIC_URL)
# ---------------------------------------------------------------------------

# APP_PUBLIC_URL plus /api. Used for webhook and intake addresses.
# Locally: http://localhost:8000/api
BACKEND_URL=

# Same as APP_PUBLIC_URL in production. Locally: http://localhost:3000
FRONTEND_BASE_URL=

# Optional. Extra browser origins allowed to call the API, comma-separated.
# APP_PUBLIC_URL is always allowed; http://localhost:3000 only while
# APP_PUBLIC_URL is not an https address (or with CORS_ALLOW_LOCALHOST=true).
# CORS_ORIGINS=
# CORS_ALLOW_LOCALHOST=

# ---------------------------------------------------------------------------
# Logins (optional; defaults shown in brackets)
# ---------------------------------------------------------------------------

# [HS256] HS256, HS384 or HS512 only.
# JWT_ALGORITHM=
# How long a login lasts, in hours. [720]
# JWT_EXPIRES_HOURS=
# [true] Set to false ONLY for a local run over http://localhost.
# AUTH_COOKIE_SECURE=

# ---------------------------------------------------------------------------
# Your company profile (optional)
# ---------------------------------------------------------------------------

# Path to your company/office details file. [backend/company_profile.json]
# COMPANY_PROFILE_PATH=

# ---------------------------------------------------------------------------
# AI: Anthropic (Claude)
# ---------------------------------------------------------------------------

# SECRET. Your Anthropic API key. Powers text screening, CV reading, call
# summaries, email replies and AI insights. (EMERGENT_LLM_KEY, an older name for
# the same setting, is still accepted.)
ANTHROPIC_API_KEY=
# Optional. The Claude model for every AI call. [claude-sonnet-5-5]
# ANTHROPIC_MODEL=
# Optional. The faster fallback the SMS and web-chat replies switch to when the
# main model is slow or rate-limited. [claude-haiku-4-5]
# ANTHROPIC_FAST_MODEL=

# ---------------------------------------------------------------------------
# Twilio: texts and the phone line (docs/TWILIO.md). Leave blank locally.
# ---------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=
# SECRET. Also proves that webhooks really come from Twilio. Without it every
# Twilio webhook (incoming texts, call status, the call bridge) is REFUSED.
TWILIO_AUTH_TOKEN=
# LOCAL ONLY. true lets unsigned "Twilio" webhooks through when you have no
# Twilio account locally. Never set this on a live deployment.
# ALLOW_UNSIGNED_TWILIO_WEBHOOKS=
# Optional. Fallback number to text from (+44... / +1...) when an office has no
# sms_number in company_profile.json.
# TWILIO_PHONE_NUMBER=
# Optional. Hours before a new starter's first day that the confirmation text goes. [3]
# TWILIO_DEFAULT_LEAD_HOURS=
# Optional. Mondays with no training cohort (comma-separated YYYY-MM-DD). When the
# AI offers a new start date by text it skips these to the following Monday.
# NO_COHORT_MONDAYS=

# ---------------------------------------------------------------------------
# ElevenLabs: Olivia's voice (docs/ELEVENLABS.md). Leave blank locally.
# ---------------------------------------------------------------------------

# SECRET.
ELEVENLABS_API_KEY=
# SECRET, you choose it (a long random string). ElevenLabs sends it as the
# X-CGR-Tool-Secret header on Olivia's tools (booking, texting the address,
# registering a caller) and on the call-start webhook; the app adds the header
# when it syncs the agents. Blank = those tools and that webhook are refused.
ELEVENLABS_TOOL_SECRET=
# SECRET, from ElevenLabs. The signing secret of your post-call webhook
# (ElevenLabs -> Agents -> Settings -> Webhooks). Blank = the post-call webhook
# is refused and the 60-second transcript sweep records outbound calls instead.
ELEVENLABS_WEBHOOK_SECRET=
# Agent syncs switch on ElevenLabs agent authentication, so nobody can open a
# browser or widget conversation with your agents (and choose the caller's
# details) without a signed URL from this app. Phone calls are unaffected.
# Set false only to debug. [true]
# ELEVENLABS_AGENT_AUTH=

# ---------------------------------------------------------------------------
# SendGrid: email (docs/SETUP.md step 10). Leave blank locally.
# ---------------------------------------------------------------------------

# SECRET. Needs Mail Send permission.
SENDGRID_API_KEY=
# A sender address SendGrid has verified, e.g. recruitment@yourcompany.co.uk
SENDGRID_FROM_EMAIL=
# Sender name used when the office's Company Name isn't set.
SENDGRID_FROM_NAME=
# Optional. Subdomain whose mail (via SendGrid Inbound Parse) becomes candidates,
# e.g. inbox.yourcompany.co.uk
# INBOUND_PARSE_DOMAIN=
# SECRET, you choose it. Inbound Parse can't sign its requests, so put this in
# the destination URL: <APP_PUBLIC_URL>/api/webhooks/sendgrid/inbound?key=<it>
# (and .../inbound-email?key=<it> for replies). Blank = inbound email is refused.
# SENDGRID_INBOUND_SECRET=
# Optional. Subdomain candidates' email replies go to (via Inbound Parse),
# e.g. replies.yourcompany.co.uk
# EMAIL_REPLY_DOMAIN=

# ---------------------------------------------------------------------------
# Google Sheets: new-hires spreadsheet (optional; off unless NEW_HIRES_SHEET_ID is set)
# ---------------------------------------------------------------------------

# The long id in the spreadsheet's address.
# NEW_HIRES_SHEET_ID=
# SECRET. A Google service-account JSON key, the whole JSON on one line...
# GOOGLE_SA_JSON_CONTENT=
# ...or a path to the key file instead.
# GOOGLE_SA_JSON_PATH=

# ---------------------------------------------------------------------------
# Field-app hand-off (optional) and server-to-server secrets
# ---------------------------------------------------------------------------

# Your field app's address (e.g. a CG1 deployment). Blank switches the hand-off off.
# CG1_BACKEND_URL=
# SECRET. Sent to, and expected from, the field app as the x-webhook-secret header.
# Blank keeps the field-app callback addresses switched off.
# CG1_WEBHOOK_SECRET=
# SECRET. Required from your field app on /api/internal/... Blank keeps those
# addresses switched off.
# CGRECRUIT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Claude connector and partner feed (optional)
# ---------------------------------------------------------------------------

# Set to off to switch off the read-only Claude connector at /mcp. [on]
# CLAUDE_CONNECTOR=
# SECRET. Key for the optional partner reporting feed at /api/partner/stage-events.
# Blank keeps the feed closed (503).
# PARTNER_FEED_API_KEY=

# RAILWAY_GIT_COMMIT_SHA is set by Railway automatically; don't set it yourself.
